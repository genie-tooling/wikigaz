# Example Environment Variables for wiki2gaz-modern
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT .env to version control.

# MongoDB Connection URI (ensure user/password are URL-encoded if needed)
# Example: mongodb://user:password@host:port/
MONGO_URI="mongodb://localhost:27017/"

# Optional: If overriding filenames from config.yaml
# WIKIDATA_DUMP_FILENAME="latest-all.json.bz2"
# WIKIPEDIA_DUMP_FILENAME="enwiki-latest-pages-articles-multistream.xml.bz2"

# Optional: API keys or other secrets if future steps require them
# SOME_API_KEY="your_secret_key"
